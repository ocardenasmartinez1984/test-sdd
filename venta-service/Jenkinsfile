// Jenkinsfile — Pipeline rápido dedicado a venta-service
//
// Etapas: Checkout → Build & Test → (SonarQube ‖ Docker Image) en paralelo.
// Optimizaciones de velocidad:
//   * UNA sola invocación de Gradle para compilar + testear (menos arranques
//     de JVM y una única configuración del proyecto).
//   * Daemon de Gradle ACTIVO + build-cache + parallel + configure-on-demand.
//   * SonarQube y la imagen Docker corren en PARALELO (independientes tras el
//     build).
//   * La imagen Docker REUTILIZA el jar ya compilado (Dockerfile.prebuilt) en
//     vez de recompilar dentro del contenedor (ahorra ~70s).
//   * Sonar reutiliza la caché de Gradle; no recompila.

pipeline {
    agent any

    environment {
        JAVA_HOME = '/usr/lib/jvm/temurin-21-jdk'
        PATH = "${JAVA_HOME}/bin:${env.PATH}"
        // Daemon ON (reused across gradle calls) + caching + parallel.
        GRADLE_OPTS = '-Dorg.gradle.daemon=true -Dorg.gradle.caching=true -Dorg.gradle.parallel=true -Dorg.gradle.configureondemand=true -Xmx2048m'
        GRADLE_USER_HOME = '/var/jenkins_home/.gradle'
        SONAR_URL = 'http://sonarqube:9000'
        IMAGE = 'ocardenasmartinez1984/venta-service'
        IMAGE_TAG = "${BUILD_NUMBER}"
        DOCKER_BUILDKIT = '1'
        COMPOSE_DOCKER_CLI_BUILD = '1'
    }

    options {
        timeout(time: 15, unit: 'MINUTES')
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timestamps()
        // Skip the implicit heavyweight SCM checkout; we do a light one below.
        skipDefaultCheckout(true)
    }

    stages {
        stage('Checkout') {
            steps {
                // Shallow clone keeps checkout fast (no full history).
                checkout([$class: 'GitSCM',
                    branches: [[name: '*/main']],
                    extensions: [[$class: 'CloneOption', shallow: true, depth: 1, noTags: true]],
                    userRemoteConfigs: [[url: 'https://github.com/ocardenasmartinez1984/test-sdd.git']]
                ])
                sh 'chmod +x gradlew'
            }
        }

        stage('Build & Test') {
            steps {
                // Single Gradle run: compiles venta-service and runs its unit
                // tests. `test` triggers jacocoTestReport via finalizedBy, and
                // producing the bootJar is part of assemble/build. Integration
                // tests (tag 'integration') are excluded by the build config.
                sh './gradlew :venta-service:build --build-cache -x jacocoTestCoverageVerification'
            }
            post {
                always {
                    junit allowEmptyResults: true,
                          testResults: 'venta-service/build/test-results/test/*.xml'
                    archiveArtifacts artifacts: 'venta-service/build/reports/jacoco/test/**',
                                     allowEmptyArchive: true, fingerprint: false
                }
            }
        }

        // Sonar and the Docker image don't depend on each other once the module
        // is built, so run them concurrently to shorten the critical path.
        stage('Quality & Package') {
            parallel {
                stage('SonarQube') {
                    steps {
                        withCredentials([string(credentialsId: 'sonar-token', variable: 'SONAR_TOKEN')]) {
                            // Reuses compiled classes + JaCoCo report from the
                            // build cache; does not recompile.
                            sh '''
                                ./gradlew :venta-service:sonar \
                                  -Dsonar.host.url=$SONAR_URL \
                                  -Dsonar.token=$SONAR_TOKEN \
                                  --build-cache
                            '''
                        }
                    }
                }
                stage('Docker Image') {
                    steps {
                        // Package the ALREADY-built jar (Dockerfile.prebuilt only
                        // copies build/libs/*.jar) instead of recompiling inside
                        // the container. Big time saver.
                        sh '''
                            docker build \
                              -f venta-service/Dockerfile.prebuilt \
                              -t ${IMAGE}:${IMAGE_TAG} \
                              -t ${IMAGE}:latest \
                              venta-service
                        '''
                        sh 'docker image ls ${IMAGE} --format "table {{.Repository}}\\t{{.Tag}}\\t{{.Size}}"'
                    }
                }
            }
        }
    }

    post {
        success { echo "✅ venta-service pipeline OK — image ${IMAGE}:${IMAGE_TAG}" }
        failure { echo '❌ venta-service pipeline failed' }
        // Light, non-blocking cleanup (dangling only) so it doesn't slow the run.
        cleanup { sh 'docker image prune -f 2>/dev/null || true' }
    }
}
