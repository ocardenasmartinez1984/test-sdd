{
  "name": "kiro-monitor",
  "version": "2.0.0",
  "description": "Enterprise-grade infrastructure & application monitoring platform",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "agent": "node src/agent/collector.js",
    "dev": "concurrently \"npm run start\" \"npm run agent\"",
    "test": "node --test src/tests/**/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage src/tests/**/*.test.js",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "dependencies": {
    "express": "4.18.2",
    "ws": "8.16.0",
    "systeminformation": "5.21.22",
    "cors": "2.8.5",
    "concurrently": "8.2.2",
    "helmet": "7.1.0",
    "express-rate-limit": "7.1.5",
    "jsonwebtoken": "9.0.2",
    "bcryptjs": "2.4.3",
    "uuid": "9.0.0",
    "@influxdata/influxdb-client": "1.33.2",
    "better-sqlite3": "9.4.3",
    "compression": "1.7.4"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}
