# ===== PostgreSQL (Auth Service) =====
POSTGRES_USER=auth_user
POSTGRES_PASSWORD=<change_me_strong_password>
POSTGRES_DB=auth_db

# ===== MongoDB =====
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=<change_me_mongo_password>

# ===== JWT =====
JWT_SECRET=<change_me_at_least_256_bits_long>

# ===== SonarQube =====
SONAR_TOKEN=<change_me_sonar_token>
SONAR_DB_USER=sonar
SONAR_DB_PASSWORD=<change_me_sonar_db_password>
